---
import runs from '../../data/figures/network.json';
import type { Lang } from '../../lib/i18n';

interface Props { id: string; lang: Lang }
const { id, lang } = Astro.props;
const text = {
  en: {
    off: 'Warm-up off', on: 'Warm-up on',
    a: 'frames per second', b: 'transit per frame (ms)', x: 'seconds after the first control',
    hint: '',
    caption: 'Figure 10. Frame rate and per-frame transit time in the first 10 seconds with and without warm-up.',
    aria: 'Frame arrival rate and per-frame transit time in the first ten seconds with and without link warm-up',
  },
  zh: {
    off: '关闭预热', on: '开启预热',
    a: '每秒到达帧数', b: '每帧传输时间（ms）', x: '第一次操作后（s）',
    hint: '',
    caption: '图 10. 连接预热前后会话前 10 秒的帧率与单帧传输耗时。',
    aria: '有无链路预热时前十秒的帧到达速率与每帧传输时间',
  },
}[lang];

type Frame = [number, number];
const data = runs as Record<'warm_off' | 'warm_on', Frame[][]>;
const COLORS = { warm_off: '#eb6834', warm_on: '#2a78d6' };
const X0 = 56, X1 = 748, A_TOP = 16, A_BOT = 132, B_TOP = 168, B_BOT = 300, A_MAX = 30, B_MAX = 2600;
const sx = (s: number) => X0 + (X1 - X0) * s / 10;
const ya = (n: number) => A_BOT - (A_BOT - A_TOP) * n / A_MAX;
const yb = (ms: number) => B_BOT - (B_BOT - B_TOP) * ms / B_MAX;
const perSecond = (frames: Frame[]) => {
  const bins = Array(10).fill(0);
  frames.forEach(([t]) => { if (t >= 0 && t < 10) bins[Math.floor(t)]++; });
  return bins;
};
const series = (Object.keys(data) as ('warm_off' | 'warm_on')[]).map(arm => ({
  arm, color: COLORS[arm],
  sessions: data[arm].map(frames => ({
    a: perSecond(frames).map((n, s) => `${s ? 'L' : 'M'} ${sx(s + 0.5).toFixed(1)} ${ya(n).toFixed(1)}`).join(' '),
    b: frames.map(([t, ms], i) => `${i ? 'L' : 'M'} ${sx(t).toFixed(1)} ${yb(ms).toFixed(1)}`).join(' '),
  })),
}));
const height = B_BOT + 34;
---
<figure class="article-figure ifig" id={id}>
  <network-warmup>
    <div class="ifig-bar">
      <p class="ifig-stats"><span class="key"><i style="--key: #eb6834"></i>{text.off}</span><span class="key"><i style="--key: #2a78d6"></i>{text.on}</span></p>
    </div>
    <svg viewBox={`0 0 760 ${height}`} role="img" aria-label={text.aria}>
      <defs><clipPath id={`${id}-reveal`}><rect class="reveal" x="0" y="0" width="760" height={height} /></clipPath></defs>
      {[0, 2, 4, 6, 8, 10].map(s => <g class="tick"><line x1={sx(s)} x2={sx(s)} y1={A_TOP} y2={A_BOT} /><line x1={sx(s)} x2={sx(s)} y1={B_TOP} y2={B_BOT} /><text x={sx(s)} y={B_BOT + 14} text-anchor="middle">{s}</text></g>)}
      {[0, 12, 24].map(n => <g class="tick"><line x1={X0} x2={X1} y1={ya(n)} y2={ya(n)} class={n === 12 ? 'fps' : ''} /><text x={X0 - 6} y={ya(n) + 3} text-anchor="end">{n}</text></g>)}
      {[0, 1000, 2000].map(ms => <g class="tick"><line x1={X0} x2={X1} y1={yb(ms)} y2={yb(ms)} /><text x={X0 - 6} y={yb(ms) + 3} text-anchor="end">{ms}</text></g>)}
      <text class="panel" x={X0} y={A_TOP - 4}>(a) {text.a}</text>
      <text class="panel" x={X0} y={B_TOP - 4}>(b) {text.b}</text>
      <text class="axis-label" x={(X0 + X1) / 2} y={B_BOT + 30} text-anchor="middle">{text.x}</text>
      <g clip-path={`url(#${id}-reveal)`}>
        {series.map(s => (
          <g class="arm" data-arm={s.arm} stroke={s.color}>
            {s.sessions.map(session => <path d={session.a} /><path d={session.b} />)}
          </g>
        ))}
      </g>
      <line class="cursor" x1={X0} x2={X0} y1={A_TOP} y2={B_BOT} />
      <rect class="hit" x={X0} y={A_TOP} width={X1 - X0} height={B_BOT - A_TOP} />
    </svg>
    <div class="ifig-foot"><output class="ifig-readout" aria-live="polite">{text.hint}</output></div>
    <script type="application/json" set:html={JSON.stringify({ lang, hint: text.hint, x0: X0, x1: X1, runs: data })}></script>
  </network-warmup>
  <figcaption>{text.caption}</figcaption>
</figure>

<style>
  network-warmup { display: block; }
  .ifig-stats { display: flex; gap: 16px; }
  .key { display: inline-flex; align-items: center; gap: 6px; }
  .key i { width: 10px; height: 10px; border-radius: 2px; background: var(--key); }
  .panel { font-size: 11px; fill: var(--muted); }
  .tick line.fps { stroke: #9aa1ab; stroke-dasharray: 4 3; }
  .arm path { fill: none; stroke-width: 1.3; stroke-opacity: .75; stroke-linejoin: round; transition: stroke-opacity 200ms ease; }
  .cursor { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 3 3; visibility: hidden; }
  network-warmup[data-scrub] .cursor { visibility: visible; }
  .hit { fill: transparent; cursor: ew-resize; }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';
  import { tooltip } from '../../scripts/tooltip';

  type Frame = [number, number];
  interface Data { lang: 'en' | 'zh'; hint: string; x0: number; x1: number; runs: Record<'warm_off' | 'warm_on', Frame[][]> }
  const median = (values: number[]) => {
    if (!values.length) return NaN;
    const sorted = [...values].sort((a, b) => a - b);
    return sorted[Math.floor(sorted.length / 2)];
  };
  const fmt = (v: number) => Number.isNaN(v) ? '—' : `${Math.round(v)} ms`;
  const say = {
    en: (t: number, off: number, on: number, fOff: number, fOn: number) => `${t.toFixed(1)} s — warm-up off ${fmt(off)} (${fOff} frames), on ${fmt(on)} (${fOn} frames)`,
    zh: (t: number, off: number, on: number, fOff: number, fOn: number) => `${t.toFixed(1)} s：关闭预热 ${fmt(off)}（${fOff} 帧），开启预热 ${fmt(on)}（${fOn} 帧）`,
  };

  class NetworkWarmup extends HTMLElement {
    frame = 0;

    connectedCallback() {
      const data: Data = JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      const cursor = this.querySelector<SVGLineElement>('.cursor')!;
      const tip = tooltip(this);
      const x = (s: number) => data.x0 + (data.x1 - data.x0) * s / 10;
      const near = (arm: 'warm_off' | 'warm_on', t: number) => median(data.runs[arm].flat().filter(f => Math.abs(f[0] - t) < 0.25).map(f => f[1]));
      const received = (arm: 'warm_off' | 'warm_on', t: number) => Math.round(data.runs[arm].reduce((sum, frames) => sum + frames.filter(f => f[0] <= t).length, 0) / data.runs[arm].length);
      const hit = this.querySelector<SVGRectElement>('.hit')!;
      hit.addEventListener('pointermove', event => {
        const box = hit.getBoundingClientRect();
        const t = Math.min(10, Math.max(0, 10 * (event.clientX - box.left) / box.width));
        this.dataset.scrub = '';
        cursor.setAttribute('x1', String(x(t)));
        cursor.setAttribute('x2', String(x(t)));
        tip.show(say[data.lang](t, near('warm_off', t), near('warm_on', t), received('warm_off', t), received('warm_on', t)), event);
      });
      hit.addEventListener('pointerleave', () => { delete this.dataset.scrub; tip.hide(); });
      const reveal = this.querySelector<SVGRectElement>('.reveal')!;
      const sweep = (seconds: number) => reveal.setAttribute('width', String(x(seconds)));
      if (reducedMotion.matches) return;
      sweep(0);
      new IntersectionObserver((entries, observer) => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect();
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / 4000);
          sweep(p * 10);
          if (p < 1) this.frame = requestAnimationFrame(tick);
        };
        this.frame = requestAnimationFrame(tick);
      }, { threshold: 0.4 }).observe(this);
    }
  }
  customElements.define('network-warmup', NetworkWarmup);
</script>

---
import type { Lang } from '../../lib/i18n';

interface Props { id: string; lang: Lang }
const { id, lang } = Astro.props;
const text = {
  en: {
    keys: ['Denoised', 'Returned'], dit: 'DiT, 4 steps',
    groups: ['8 frames', '4 frames', '2 frames'],
    every: (ms: number) => `Read control every ${ms} ms`,
    row: (k: number, at: number, a: number, b: number) => `Pass ${k} (${at} ms): frames ${a}–${b}`,
    caption: 'Figure 6. Sampling passes within one chunk under 8-, 4-, and 2-frame feedback.',
    aria: 'Passes within one chunk for 8-frame, 4-frame, and two-frame feedback',
  },
  zh: {
    keys: ['去噪', '本轮返回'], dit: 'DiT 四步去噪',
    groups: ['8 帧', '4 帧', '2 帧'],
    every: (ms: number) => `每 ${ms} ms 读入一次操作`,
    row: (k: number, at: number, a: number, b: number) => `第 ${k} 轮（${at} ms）：返回第 ${a}–${b} 帧`,
    caption: '图 6. 8 帧、4 帧与 2 帧反馈在一个 chunk 内的采样方式。',
    aria: '一个 chunk 内 8 帧、4 帧和两帧反馈的各轮采样',
  },
}[lang];

const ms = (frames: number) => Math.round(frames * 1000 / 12);
const GROUPS = [8, 4, 2];
const TOP = 62, ROW = 34, RH = 24, GAP = 18, LX = [168, 236], LW = 60, GX = 352, PITCH = 50, CW = 48;
const tips: Record<string, string> = {};
let y = TOP;
const groups = GROUPS.map((f, gi) => {
  const passes = 8 / f, top = y;
  const rows = Array.from({ length: passes }, (_, r) => {
    const k = r + 1, a = r * f + 1, b = k * f;
    tips[`r${gi}${r}`] = text.row(k, ms(a - 1), a, b);
    const row = { y, k, cells: Array.from({ length: 8 }, (_, i) => i + 1 >= a && i + 1 <= b), step: r };
    y += ROW;
    return row;
  });
  tips[`g${gi}`] = text.every(ms(f));
  const out = { gi, top, bottom: y - ROW + RH, rows, title: text.groups[gi] };
  y += GAP;
  return out;
});
const height = y - GAP + 8;
const cx = (i: number) => GX + i * PITCH;
---
<figure class="article-figure ifig" id={id}>
  <feedback-passes>
    <div class="ifig-bar">
      <p class="ifig-stats keys">
        <span class="key"><i class="k-den"></i>{text.keys[0]}</span>
        <span class="key"><i class="k-ret"></i>{text.keys[1]}</span>
      </p>
    </div>
    <svg viewBox={`0 0 760 ${height}`} role="img" aria-label={text.aria}>
      <text class="head" x={(LX[0] + LX[1] + LW) / 2} y={TOP - 30} text-anchor="middle">{text.dit}</text>
      {[0, 1].map(g => (
        <g class="bracket">
          <path d={`M ${cx(g * 4)} ${TOP - 26} V ${TOP - 30} H ${cx(g * 4 + 3) + CW} V ${TOP - 26}`} />
          <text x={(cx(g * 4) + cx(g * 4 + 3) + CW) / 2} y={TOP - 35} text-anchor="middle">L{'₁₂'[g]}</text>
        </g>
      ))}
      {Array.from({ length: 8 }, (_, i) => <text class="num" x={cx(i) + CW / 2} y={TOP - 10} text-anchor="middle">{i + 1}</text>)}
      {groups.map(g => (
        <g class="group">
          {g.gi > 0 && <line class="sep" x1="0" x2="760" y1={g.top - GAP / 2 - 1} y2={g.top - GAP / 2 - 1} />}
          <g data-k={`g${g.gi}`} class="title">
            <rect class="hit" x="0" y={g.top - 4} width="150" height={g.bottom - g.top + 8} />
            <text class="g-title" x="0" y={(g.top + g.bottom) / 2 + 5}>{g.title}</text>
          </g>
          {g.rows.map(row => (
            <g class="row" data-step={row.step} data-k={`r${g.gi}${row.step}`}>
              <rect class="band" x="140" y={row.y - 5} width="620" height={RH + 10} rx="3" />
              <text class="pass" x="148" y={row.y + 16} text-anchor="middle">{row.k}</text>
              {[0, 1].map(i => (
                <g class="latent">
                  <rect class="den" x={LX[i]} y={row.y} width={LW} height={RH} rx="2" />
                  <text x={LX[i] + LW / 2} y={row.y + 16} text-anchor="middle">L{'₁₂'[i]}</text>
                </g>
              ))}
              <line class="arrow" x1={LX[1] + LW + 10} x2={GX - 12} y1={row.y + RH / 2} y2={row.y + RH / 2} />
              {row.cells.map((on, i) => <rect class={on ? 'cell ret' : 'cell'} x={cx(i)} y={row.y} width={CW} height={RH} />)}
            </g>
          ))}
        </g>
      ))}
      <line class="split" x1={cx(4) - 1} x2={cx(4) - 1} y1={TOP - 4} y2={height - 6} />
    </svg>
    <div class="ifig-foot"><output class="ifig-readout" aria-live="polite"></output></div>
    <script type="application/json" set:html={JSON.stringify(tips)}></script>
  </feedback-passes>
  <figcaption>{text.caption}</figcaption>
</figure>

<style>
  feedback-passes { display: block; }
  .keys { display: flex; gap: 16px; }
  .key { display: inline-flex; align-items: center; gap: 6px; }
  .key i { width: 12px; height: 10px; border-radius: 2px; }
  .k-den { background: #f8d3bf; border: 1px solid #eb6834; }
  .k-ret { background: #2a78d6; }
  .head, .bracket text { font-size: 11px; fill: var(--muted); }
  .bracket path { fill: none; stroke: #b9c0ca; }
  .num { font-size: 10px; fill: #9aa1ab; }
  .sep { stroke: var(--line); }
  .g-title { font-size: 14px; font-weight: 600; fill: var(--ink); }
  .pass { font-size: 11px; fill: #9aa1ab; }
  .band { fill: transparent; }
  .row:hover .band { fill: rgb(37 99 235 / 5%); }
  .latent text { font-size: 11px; font-style: italic; fill: var(--ink); pointer-events: none; }
  rect.den { fill: #f8d3bf; stroke: #eb6834; }
  .arrow { stroke: #59606b; stroke-width: 1; }
  .cell { fill: white; stroke: #e2e5ea; }
  .cell.ret { fill: #2a78d6; stroke: white; }
  .split { stroke: #59606b; stroke-width: 1; }
  .hit { fill: transparent; }
</style>

<script>
  import { tooltip } from '../../scripts/tooltip';

  class FeedbackPasses extends HTMLElement {
    connectedCallback() {
      const tips: Record<string, string> = JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      const tip = tooltip(this);
      this.querySelectorAll<SVGGElement>('[data-k]').forEach(el => {
        el.addEventListener('pointermove', event => { event.stopPropagation(); tip.show(tips[el.dataset.k!], event); });
        el.addEventListener('pointerleave', () => tip.hide());
      });
    }
  }
  customElements.define('feedback-passes', FeedbackPasses);
</script>
